            <div
              class="c49"
            >
              <span
                class="c9 c50"
              >
                This site is built in
                 
                <a
                  aria-label="React (opens in a new tab)"
                  class="c11"
                  href="https://reactjs.org/"
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  <span
                    class="c12"
                  >
                    React
                  </span>
                  <div
                    class="c51"
                  >
                    <svg
                      class="c52 c53"
                      height="18"
                      viewBox="0 0 24 24"
                      width="18"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M12.5 11.3c.4.4 1 .4 1.4 0L19 6.2V9c0 .6.4 1 1 1s1-.4 1-1V4c0-.6-.4-1-1-1h-5c-.6 0-1 .4-1 1s.4 1 1 1h2.4l-4.9 4.9c-.4.4-.4 1 0 1.4zM19 19c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2h7v2H5v12h12v-7h2"
                      />
                    </svg>
                  </div>
                </a>
                 
                and
                 
                <a
                  aria-label="Redux (opens in a new tab)"
                  class="c11"
                  href="https://redux.js.org/"
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  <span
                    class="c12"
                  >
                    Redux
                  </span>
                  <div
                    class="c51"
                  >
                    <svg
                      class="c52 c53"
                      height="18"
                      viewBox="0 0 24 24"
                      width="18"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M12.5 11.3c.4.4 1 .4 1.4 0L19 6.2V9c0 .6.4 1 1 1s1-.4 1-1V4c0-.6-.4-1-1-1h-5c-.6 0-1 .4-1 1s.4 1 1 1h2.4l-4.9 4.9c-.4.4-.4 1 0 1.4zM19 19c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2h7v2H5v12h12v-7h2"
                      />
                    </svg>
                  </div>
                </a>
                 
                taking advantage of
                 
                <a
                  aria-label="Next.js (opens in a new tab)"
                  class="c11"
                  href="https://nextjs.org/"
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  <span
                    class="c12"
                  >
                    Next.js
                  </span>
                  <div
                    class="c51"
                  >
                    <svg
                      class="c52 c53"
                      height="18"
                      viewBox="0 0 24 24"
                      width="18"
                      xmlns="http://www.w3.org/2000/svg"
                    >
                      <path
                        d="M12.5 11.3c.4.4 1 .4 1.4 0L19 6.2V9c0 .6.4 1 1 1s1-.4 1-1V4c0-.6-.4-1-1-1h-5c-.6 0-1 .4-1 1s.4 1 1 1h2.4l-4.9 4.9c-.4.4-.4 1 0 1.4zM19 19c0 1.1-.9 2-2 2H5c-1.1 0-2-.9-2-2V7c0-1.1.9-2 2-2h7v2H5v12h12v-7h2"
                      />
                    </svg>
                  </div>
                </a>
                . I serve it from an EC2 container on
                 
                <a
                  aria-label="AWS (opens in a new tab)"
                  class="c11"
                  href="https://aws.amazon.com/"
                  rel="noopener noreferrer"
                  target="_blank"
